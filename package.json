{
  "name": "routepilot",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "pnpm check:version && pnpm typecheck && vite build",
    "preview": "vite preview",
    "check:version": "node scripts/check-version.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test:frontend": "vitest run",
    "test:scripts": "node --test scripts/*.node-test.mjs",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "audit": "pnpm audit --prod && cargo audit --file src-tauri/Cargo.lock",
    "verify": "pnpm check:version && pnpm typecheck && pnpm test:frontend && pnpm test:scripts && vite build && pnpm format:check && pnpm lint:rust && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
